					elseif typeof(v) == "CFrame" then
						args[i] = CFrame.new(silentAimCache.pos); replaced = true
					end
				end
				if replaced then return oldNamecall(self, unpack(args)) end
			end
			return oldNamecall(self, ...)
		end))
