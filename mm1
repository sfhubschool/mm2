				local murderPlr = findMurdererPlayer()
				if not (murderPlr and murderPlr.Character) then return end
				local targetPos = getTargetHitPosition(murderPlr.Character, dt)
				if not targetPos then return end
				local canShoot = hasLineOfSight(targetPos, murderPlr.Character)
				Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
				if canShoot then tool:Activate() end
			end)
		end

