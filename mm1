	local function getTargetHitPosition(targetChar, dt)
		local head = targetChar:FindFirstChild("Head")
		local upperTorso = targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso")
		local rootPart = targetChar:FindFirstChild("HumanoidRootPart")
		local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
		if not rootPart then return nil end
		if humanoid and humanoid.Health <= 0 then return nil end
		local baseTargetPos
		if head then baseTargetPos = head.Position
		elseif upperTorso then baseTargetPos = upperTorso.Position + Vector3.new(0, 1, 0)
		else baseTargetPos = rootPart.Position + Vector3.new(0, 1.5, 0) end

		local ping = 0.05
		pcall(function() ping = localPlayer:GetNetworkPing() * 2 + 0.035 end)
		ping = math.clamp(ping, 0.02, 0.35)

		local vel = rootPart.AssemblyLinearVelocity
		local horizontal = Vector3.new(vel.X, 0, vel.Z) * ping
		local verticalY = vel.Y * ping

		local inAir = false
		if humanoid then
			local st = humanoid:GetState()
			inAir = (st == Enum.HumanoidStateType.Jumping
				or st == Enum.HumanoidStateType.Freefall
				or st == Enum.HumanoidStateType.FallingDown)
				or humanoid.FloorMaterial == Enum.Material.Air
		end
		if inAir then verticalY = verticalY - (0.5 * Workspace.Gravity * ping * ping) end

		return baseTargetPos + horizontal + Vector3.new(0, verticalY + 0.1, 0)
	end

	local function hasLineOfSight(targetPos, targetChar)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignore = { Camera }
		if localPlayer.Character then table.insert(ignore, localPlayer.Character) end
		params.FilterDescendantsInstances = ignore
		local origin = Camera.CFrame.Position
		local result = Workspace:Raycast(origin, targetPos - origin, params)
		if not result then return true end
		return result.Instance:IsDescendantOf(targetChar)
	end

