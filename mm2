	local function countTotalCoinsOnMap()
		local count = 0
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("BasePart") then
				local nameLower = obj.Name:lower()
				if nameLower == "coin" or nameLower == "coins" or nameLower:find("coin") or nameLower:find("piece") or nameLower:find("pièce") then
					count = count + 1
				end
			end
		end
		return count
	end

	local function findNearestValidCoin()
		local nearest = nil
		local shortestDist = math.huge
		local char = localPlayer.Character
		if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
		local rootPos = char.HumanoidRootPart.Position

		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("BasePart") and obj.Parent then
				local nameLower = obj.Name:lower()
				if nameLower == "coin" or nameLower == "coins" or nameLower:find("coin") or nameLower:find("piece") or nameLower:find("pièce") then
					if obj.Transparency < 1 and obj.Size.Magnitude > 0 then
						local dist = (obj.Position - rootPos).Magnitude
						if dist < shortestDist then
							shortestDist = dist
							nearest = obj
						end
					end
				end
			end
		end
		return nearest
	end

	task.spawn(function()
		local waitingForNewRound = false

		while true do
			if autoFarmEnabled then
				local char = localPlayer.Character
				if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid") then
					local rootPart = char.HumanoidRootPart
					local humanoid = char:FindFirstChildOfClass("Humanoid")
					local totalCoins = countTotalCoinsOnMap()
					
					if totalCoins == 0 then
						if not waitingForNewRound then
							waitingForNewRound = true
							autofarmBtn.Text = L("WaitMap")
							autofarmBtn.TextColor3 = Color3.fromRGB(255, 180, 50)
						end
						humanoid.PlatformStand = false
						task.wait(0.5)
					else
						if waitingForNewRound then
							waitingForNewRound = false
							autofarmBtn.Text = L("AutoFarmCoins") .. "ON"
							autofarmBtn.TextColor3 = Color3.fromRGB(90, 255, 90)
						end
						
						local coin = findNearestValidCoin()
						if coin and coin.Parent and coin.Transparency < 1 then
							humanoid.PlatformStand = true
							
							local startTime = tick()
							while autoFarmEnabled and coin and coin.Parent and coin.Transparency < 1 do
								local targetPos = coin.Position + Vector3.new(0, 0.5, 0)
								local distance = (rootPart.Position - targetPos).Magnitude
								
								if distance < 1.5 then 
									break 
								end
								
								if tick() - startTime > 1.5 then
									rootPart.CFrame = rootPart.CFrame:Lerp(CFrame.new(targetPos), 0.3)
									break
								end

								local dt = RunService.RenderStepped:Wait()
								local alpha = math.clamp((autoFarmSpeed * 0.7 * dt) / math.max(distance, 0.1), 0, 1)
								local nextPos = rootPart.Position:Lerp(targetPos, alpha)
								
								rootPart.CFrame = CFrame.new(nextPos)
								rootPart.AssemblyLinearVelocity = Vector3.zero
								rootPart.AssemblyAngularVelocity = Vector3.zero
							end
							
							if coin and coin.Parent then 
								rootPart.CFrame = CFrame.new(rootPart.Position:Lerp(coin.Position + Vector3.new(0, 0.5, 0), 0.5))
							end
							
							rootPart.AssemblyLinearVelocity = Vector3.zero
							rootPart.AssemblyAngularVelocity = Vector3.zero
							task.wait(0.05)
							humanoid.PlatformStand = false
						else
							humanoid.PlatformStand = false
							task.wait(0.1)
						end
					end
				else
					task.wait(0.5)
				end
			else
				task.wait(0.2)
			end
		end
	end)

	local function findPlayerByRole(targetRole)
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= localPlayer then
				local char = plr.Character
				local function checkContainer(container)
					if not container then return false end
					for _, item in ipairs(container:GetChildren()) do
						if item:IsA("Tool") then
							local name = item.Name:lower()
							if targetRole == "Murderer" and (name == "knife" or name:find("couteau")) then return true
							elseif targetRole == "Sheriff" and (name == "gun" or name == "revolver" or name:find("pistolet")) then return true end
						end
					end
					return false
				end
				if checkContainer(plr.Backpack) or (char and checkContainer(char)) then return plr end
			end
		end
		return nil
	end

