					end

					for _, obj in ipairs(Workspace:GetChildren()) do
						if obj:IsA("BackpackItem") or obj:IsA("Tool") then
							local nameLower = obj.Name:lower()
							if nameLower == "gun" or nameLower == "revolver" or nameLower:find("pistolet") or nameLower:find("droppedgun") then
								local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
								if handle and handle.Parent then
									local originalPos = hrp.CFrame
									hrp.CFrame = handle.CFrame + Vector3.new(0, 0.5, 0)
									task.wait(0.08)
									hrp.CFrame = originalPos
									break
								end
							end
						end
					end
				end
			end)
		end
		
		-- Premier système d'aim lock (Aim Lock for Clip avec tir permanent et ultra précis sur la tête)
		if autoShootMurderEnabled then
			pcall(function()
				local char = localPlayer.Character
				if char then
					local tool = char:FindFirstChildOfClass("Tool")
					if tool then
						local name = tool.Name:lower()
						if name == "gun" or name == "revolver" or name:find("pistolet") then
							local murderPlr = findMurdererPlayer()
							if murderPlr and murderPlr.Character then
								local preciseTargetPos = getTargetHitPosition(murderPlr.Character, dt)
								if preciseTargetPos then
									local camCF = Camera.CFrame
									local shiftLockOffset = camCF.RightVector * 1.75
									local adjustedCamPos = camCF.Position + shiftLockOffset
									
									local targetCFrame = CFrame.new(adjustedCamPos, preciseTargetPos)
									Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 1)
									tool:Activate()
								end
							end
						end
					end
				end
			end)
		end
		
		-- Second système d'aim lock principal Shérif / Bouton Flottant avec Shift Lock activé
		local murderPlr = findMurdererPlayer()
		if murderPlr and murderPlr.Character and murderPlr.Character:FindFirstChild("HumanoidRootPart") then
			local murderChar = murderPlr.Character
			local preciseTargetPos = getTargetHitPosition(murderChar, dt)
			
			if preciseTargetPos then
				local aimlockActive = sheriffAimlockEnabled and floatActiveState
				
				if aimlockActive then
					headCrosshair.Visible = true
					local camCF = Camera.CFrame
					local shiftLockOffset = camCF.RightVector * 1.75
					local adjustedCamPos = camCF.Position + shiftLockOffset
					
					local targetCFrame = CFrame.new(adjustedCamPos, preciseTargetPos)
					Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 1)
				else
					headCrosshair.Visible = false
				end
			else
				headCrosshair.Visible = false
			end
		else
			headCrosshair.Visible = false
		end
	end)

