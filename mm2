		aimlockFloatGui = Instance.new("ScreenGui")
		aimlockFloatGui.Name = "AimlockFloatingPanel"
		aimlockFloatGui.ResetOnSpawn = false
		aimlockFloatGui.Parent = playerGui

		local floatFrame = Instance.new("Frame")
		floatFrame.Name = "FloatFrame"
