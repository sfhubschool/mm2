	local function generateBackground(mode)
		clearBackground()
		local count = (mode == "Stars") and 22 or 14
		for i = 1, count do
			local p = Instance.new("Frame")
			local size = (mode == "Stars") and math.random(15, 35) or math.random(60, 140)
			p.Size = UDim2.new(0, size, 0, size)
			p.Position = UDim2.new(math.random(), 0, math.random(), 0)
			p.BackgroundColor3 = Color3.fromRGB(math.random(80, 160), math.random(120, 230), math.random(220, 255))
			p.BackgroundTransparency = 0.82
			p.BorderSizePixel = 0
			
			local corner = Instance.new("UICorner")
			if mode == "Bubbles" then corner.CornerRadius = UDim.new(1, 0)
			elseif mode == "Cubes" then corner.CornerRadius = UDim.new(0, 10)
			else corner.CornerRadius = UDim.new(0.3, 0) end
			corner.Parent = p
			
			p.Parent = bgContainer
			table.insert(bgElements, { Obj = p, SpeedX = math.random(-12, 12) / 100, SpeedY = math.random(-12, 12) / 100, RotSpeed = math.random(-25, 25) })
		end
	end

