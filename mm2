			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			if char and char:FindFirstChild("HumanoidRootPart") then
				local myRoot = char.HumanoidRootPart
				if humanoid then humanoid.PlatformStand = true end
				
				local spinAngle = tick() * tornadoSpeed
				local fixedHeightPos = tRoot.Position + Vector3.new(0, 10, 0)
				local focusCFrame = CFrame.new(fixedHeightPos) * CFrame.Angles(0, spinAngle, 0) * CFrame.new(0, 0, 2) * CFrame.Angles(0, spinAngle * 3, 0)
				
				myRoot.CFrame = focusCFrame
				myRoot.AssemblyLinearVelocity = Vector3.zero
				myRoot.AssemblyAngularVelocity = Vector3.zero
			end
		else
			local char = localPlayer.Character
			if char then
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				if humanoid and humanoid.PlatformStand then
					humanoid.PlatformStand = false
				end
			end
		end

