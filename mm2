	-- FONCTION DE PRÉCISION AMÉLIORÉE : Cible la tête/cou précisément en prédisant les mouvements et les sauts
	local function getTargetHitPosition(targetChar, dt)
		local head = targetChar:FindFirstChild("Head")
		local upperTorso = targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso")
		local rootPart = targetChar:FindFirstChild("HumanoidRootPart")
		local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
		
		-- Visée ultra précise centrée sur la tête/cou
		local baseTargetPos = nil
		if head then
			baseTargetPos = head.Position
		elseif upperTorso then
			baseTargetPos = upperTorso.Position + Vector3.new(0, 1, 0)
		elseif rootPart then
			baseTargetPos = rootPart.Position + Vector3.new(0, 1.5, 0)
		end

		if baseTargetPos and rootPart then
			local targetVelocity = rootPart.AssemblyLinearVelocity
			
			local jumpCompensation = 0
			if humanoid then
				local state = humanoid:GetState()
				if state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.FallingDown then
					if targetVelocity.Y > 0.1 then
						jumpCompensation = (targetVelocity.Y * 0.16) + 1.1
					else
						jumpCompensation = (targetVelocity.Y * 0.14)
					end
				end
			end

			local distanceToTarget = 0
			local myChar = localPlayer.Character
			local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
			if myRoot then
				distanceToTarget = (myRoot.Position - rootPart.Position).Magnitude
			end
			local distancePredictionScale = math.clamp(distanceToTarget * 0.003, 1, 1.8)

			local horizontalPrediction = Vector3.new(targetVelocity.X, 0, targetVelocity.Z) * 0.14 * distancePredictionScale
			local verticalPrediction = Vector3.new(0, jumpCompensation, 0)
			
			local finalPredictedPosition = baseTargetPos + horizontalPrediction + verticalPrediction
			return finalPredictedPosition
		end
		
		return nil
	end

