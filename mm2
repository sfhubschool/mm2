-- Fonction pour activer automatiquement le Shift Lock natif / simulé Roblox
local function enableNativeShiftLock()
	pcall(function()
		local playerModule = localPlayer:FindFirstChild("PlayerScripts") and localPlayer.PlayerScripts:FindFirstChild("PlayerModule")
		if playerModule then
			local camModule = require(playerModule):GetService("CameraModule")
			if camModule and camModule.SetActiveShiftLock then
				-- Force l'activation du shiftlock interne si disponible
				local ok = pcall(function()
					local shiftLockController = require(playerModule.CameraModule.ShiftLockController)
					if shiftLockController and not shiftLockController:IsShiftLocked() then
						shiftLockController:ToggleShiftLock()
					end
				end)
			end
		end
		-- Simulation visuelle et mécanique alternative
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		showShiftLockAlert()
	end)
end

