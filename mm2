		floatFrame.Position = UDim2.new(0.5, -95, 0.85, 0)
		floatFrame.BackgroundColor3 = Color3.fromRGB(14, 16, 24)
		floatFrame.BorderSizePixel = 0
		floatFrame.Active = true
		floatFrame.Draggable = true
		floatFrame.Parent = aimlockFloatGui

		local floatCorner = Instance.new("UICorner")
		floatCorner.CornerRadius = UDim.new(0, 12)
		floatCorner.Parent = floatFrame

		local floatStroke = Instance.new("UIStroke")
		floatStroke.Color = floatActiveState and Color3.fromRGB(90, 255, 90) or Color3.fromRGB(140, 150, 230)
		floatStroke.Thickness = 1.5
		floatStroke.Transparency = 0.4
		floatStroke.Parent = floatFrame

		local floatBtn = Instance.new("TextButton")
		floatBtn.Size = UDim2.new(1, 0, 1, 0)
		floatBtn.BackgroundTransparency = 1
		floatBtn.Text = floatActiveState and "Aimlock + ShiftLock : ON" or "Aimlock + ShiftLock : OFF"
		floatBtn.TextColor3 = floatActiveState and Color3.fromRGB(90, 255, 90) or Color3.fromRGB(255, 90, 90)
		floatBtn.TextSize = 12
		floatBtn.Font = Enum.Font.GothamBold
		floatBtn.Parent = floatFrame

		floatBtn.MouseButton1Click:Connect(function()
			playKeyboardSound()
			floatActiveState = not floatActiveState
			if floatActiveState then
				floatBtn.Text = "Aimlock + ShiftLock : ON"
				floatBtn.TextColor3 = Color3.fromRGB(90, 255, 90)
				floatStroke.Color = Color3.fromRGB(90, 255, 90)
				enableNativeShiftLock()
			else
				floatBtn.Text = "Aimlock + ShiftLock : OFF"
				floatBtn.TextColor3 = Color3.fromRGB(255, 90, 90)
				floatStroke.Color = Color3.fromRGB(140, 150, 230)
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			end
		end)
	else
		if aimlockFloatGui then
			aimlockFloatGui:Destroy()
			aimlockFloatGui = nil
		end
		floatActiveState = false
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
end

